<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.4.0-preview.5</Version>
    <ApplicationIcon>Squadlink.ico</ApplicationIcon>
    <AssemblyName>Squadlink</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../public/*" Exclude="../public/sw.js;../public/install.js;../public/manifest.webmanifest" Link="Client/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Desktop/*" Link="Client/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <AssemblyMetadata Include="SquadlinkBuild" Value="$(SquadlinkBuildNumber).$(SquadlinkBuildAttempt)" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
  </ItemGroup>
</Project>
